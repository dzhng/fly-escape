__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Artifacts (optional - can be large)
# artifacts/

# Terminal files
terminals/
