# Data files (too large for git)
# Keep .gitkeep files to preserve directory structure
data/*.feather
data/raw/*.feather
data/processed/*
!data/processed/brain/
data/processed/brain/*
!data/processed/brain/graph.bin
!data/processed/brain/manifest.json

# But keep the raw directory structure
!data/raw/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Artifacts (optional - can be large)
# artifacts/

# Terminal files
terminals/

# Incomplete source transfers and generated provenance for local raw files
data/raw/*.part
data/raw/sources.json

# Rust, browser builds and generated WASM
target/
dist/
packages/sim-client/src/wasm/
apps/web/public/brain/
