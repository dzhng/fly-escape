{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": true
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/lab(?:/.*)?",
      "dest": "/index.html"
    }
  ]
}
