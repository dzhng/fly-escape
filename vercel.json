{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "apps/web/dist",
  "git": { "deploymentEnabled": true },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/lab(?:/.*)?", "dest": "/index.html" }
  ]
}
