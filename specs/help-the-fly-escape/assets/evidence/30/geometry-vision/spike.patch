+/// SCRATCH (geometry-vision spike): encode three modeled proximity rays
+/// (forward, left, right) into the existing lateral `visionL`/`visionR` sensory
+/// groups. Ipsilateral encoding only, with the forward ray shared equally by both
+/// sides; there is no contralateral turn rule, no motor injection and no
+/// avoidance fallback. Downstream steering, if any, is the graph's own result.
+pub fn proximity_currents(
+    graph: &Graph,
+    proximity: [f64; 3],
+    gain: f64,
+) -> Result<Vec<(u32, f64)>, String> {
+    if !gain.is_finite() || !(0.0..=3.0).contains(&gain) {
+        return Err("proximity gain must be between zero and three".into());
+    }
+    if proximity.iter().any(|v| !v.is_finite() || !(0.0..=1.0).contains(v)) {
+        return Err("proximity must be normalized to zero..one".into());
+    }
+    let [forward, left, right] = proximity;
+    group_currents(
+        graph,
+        ["visionL", "visionR"],
+        [
+            (gain * (left + 0.5 * forward)).clamp(0.0, 3.0),
+            (gain * (right + 0.5 * forward)).clamp(0.0, 3.0),
+        ],
+    )
+}
