+    /// SCRATCH (geometry-vision spike): first surface hit along an arbitrary short
+    /// direction. Same normalized-unit contract as `below`; returns metres.
+    pub fn along(
+        &self,
+        position: [f64; 3],
+        direction: [f64; 3],
+        distance: f64,
+    ) -> Result<Option<SurfaceHit>, String> {
+        if !bounded(position)
+            || !direction.iter().all(|c| c.is_finite())
+            || !distance.is_finite()
+            || distance <= 0.
+            || distance > MAX_COORDINATE
+        {
+            return Err("surface ray requires a bounded pose and positive distance".into());
+        }
+        let dir = Vector::from_array(direction);
+        if dir.length_squared() <= 0. {
+            return Err("surface ray requires a nonzero direction".into());
+        }
+        let ray = Ray::new(
+            Vector::from_array(position) * QUERY_UNITS,
+            dir.normalize() * distance * QUERY_UNITS,
+        );
+        let mut first = None;
+        for entry in &self.meshes {
+            if let Some(hit) = entry.mesh.cast_local_ray_and_get_normal(&ray, 1., false) {
+                select(
+                    &mut first,
+                    checked_hit(
+                        entry.id,
+                        hit.time_of_impact,
+                        ray.point_at(hit.time_of_impact) / QUERY_UNITS,
+                        hit.normal,
+                    )?,
+                );
+            }
+        }
+        Ok(first)
+    }
