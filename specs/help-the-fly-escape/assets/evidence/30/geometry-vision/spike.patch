+    /// SCRATCH (geometry-vision spike): three short body-frame rays (forward,
+    /// left, right) against this world's own room/solid geometry and native
+    /// object surfaces. Returns normalized proximity in 0..1 per ray (1 = touching).
+    /// Modeled proximity only: this is not rendered fly vision and carries no
+    /// steering, motor or avoidance authority.
+    pub fn proximity(&self, pose: BodyPose, reach: f64, spread: f64) -> [f64; 3] {
+        if !reach.is_finite() || reach <= 0. || !pose.position.finite() || !pose.heading.is_finite()
+        {
+            return [0.; 3];
+        }
+        [0., spread, -spread].map(|offset| {
+            let a = pose.heading + offset;
+            let (dx, dz) = (a.cos(), a.sin());
+            let to = Point {
+                x: pose.position.x + dx * reach,
+                z: pose.position.z + dz * reach,
+            };
+            let stop = self.geometry.sweep(pose.position, to, 0.);
+            let mut travel = pose.position.distance(stop).min(reach);
+            if let Ok(Some(hit)) = self.surfaces.along(
+                [pose.position.x, 0.01, pose.position.z],
+                [dx, 0., dz],
+                reach,
+            ) {
+                travel = travel.min(hit.fraction * reach);
+            }
+            (1. - travel / reach).clamp(0., 1.)
+        })
+    }
