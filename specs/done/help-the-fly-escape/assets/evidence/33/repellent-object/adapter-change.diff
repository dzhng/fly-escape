+/// SCRATCH (repellent-object spike): graded same-side receptor drive.
+/// The local field concentration measured at each antenna scales the external current on that
+/// side's receptor indices. Same-side wiring only: no sign flip, no binarized lateral detector,
+/// no motor injection, and readout populations are excluded exactly as `group_currents` does.
+/// `scale` is an input-current amplitude supplied by the caller, not fitted to any outcome.
+pub fn graded_side_currents(
+    graph: &Graph,
+    sides: [&[u32]; 2],
+    values: [f64; 2],
+    scale: f64,
+) -> Result<Vec<(u32, f64)>, String> {
+    if !scale.is_finite() || !(0.0..=3.0).contains(&scale) {
+        return Err("receptor drive scale must be between zero and three".into());
+    }
+    if values.iter().any(|v| !v.is_finite() || *v < 0.0) {
+        return Err("field concentrations must be finite and nonnegative".into());
+    }
+    let readouts = motor_readout_indices(graph);
+    let mut currents = BTreeMap::new();
+    for (indices, value) in sides.into_iter().zip(values) {
+        let current = scale * value.clamp(0.0, 1.0);
+        for &index in indices.iter().filter(|i| !readouts.contains(i)) {
+            *currents.entry(index).or_insert(0.0) += current;
+        }
+    }
+    Ok(currents.into_iter().collect())
+}
+
